{
  "name": "mcwcasinoforum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,wp -c cyan,magenta \"vite\" \"npm run dev:wp\"",
    "dev:express": "concurrently -n web,api -c cyan,yellow \"vite --mode express\" \"npm run dev --prefix backend\"",
    "dev:web": "vite",
    "dev:wp": "php -S 127.0.0.1:8080 -t wordpress wordpress/router.php",
    "dev:api": "npm run dev --prefix backend",
    "wp:cli": "php tools/wordpress/wp-cli.phar --path=wordpress",
    "wp:seed": "php tools/wordpress/wp-cli.phar --path=wordpress mcw seed",
    "wp:seed:reset": "php tools/wordpress/wp-cli.phar --path=wordpress mcw seed --reset",
    "install:all": "npm install && npm install --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:push": "npm run db:push --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:security:admin": "php wordpress/wp-content/plugins/mcw-forum/tests/admin-account-security.php",
    "test:security:spam": "php wordpress/wp-content/plugins/mcw-forum/tests/anti-spam-content-guard.php",
    "test:security:db": "php wordpress/wp-content/plugins/mcw-forum/tests/database-security.php",
    "test:security:upload": "php wordpress/wp-content/plugins/mcw-forum/tests/upload-security.php",
    "test:all": "vitest run && npm test --prefix backend && playwright test"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "@playwright/test": "^1.58.2"
  }
}
