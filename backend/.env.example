PORT=4000
DATABASE_URL="mysql://root:password@localhost:3306/mcwforum"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_NAME=mcwforum
# Optional. Auto-detected on macOS (/tmp/mysql.sock) and Linux if unset.
# DATABASE_SOCKET=/tmp/mysql.sock

# REQUIRED in production: long random secret (32+ chars). Never commit real values.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend origin (cookies + CORS). Must match the browser URL exactly.
CORS_ORIGIN=http://localhost:5173

# Cookie auth (HttpOnly). COOKIE_SECURE=true required behind HTTPS in production.
AUTH_COOKIE_NAME=mcw_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Session idle timeout (ms). Default 30 minutes.
SESSION_IDLE_TIMEOUT_MS=1800000

# Login brute-force protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20

JSON_BODY_LIMIT=8mb
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Trust X-Forwarded-For only when nginx is in front.
# TRUST_PROXY=1
# NODE_ENV=production
# COOKIE_SECURE=true
