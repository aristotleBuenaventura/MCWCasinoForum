# =============================================================================
# MCW Casino Forum — production / staging environment TEMPLATE
# Copy to a secrets-managed location. NEVER commit real values.
# Primary API path: React SPA → /api → WordPress /wp-json/mcw/v1 (NOT Node).
# =============================================================================

# --- Vite SPA (build-time public vars only) ---
VITE_TURNSTILE_SITEKEY=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SITEKEY

# --- WordPress (prefer define() in wp-config; env shown for documentation) ---
MCW_CORS_ORIGIN=https://www.example.com
MCW_FORCE_SECURE_COOKIES=true
MCW_TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET
MCW_TURNSTILE_REQUIRED=true
# WP_DEBUG_DISPLAY must be false in production (set in wp-config)

# --- Database (WordPress wp-config) ---
# DB_NAME=mcwforum
# DB_USER=mcw_app
# DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# DB_HOST=localhost

# --- Optional legacy Node backend (DO NOT expose publicly if unused) ---
# Only needed when running `vite --mode express` / historical droplet layout.
# PORT=4000
# DATABASE_URL=mysql://mcw_app:REPLACE@localhost:3306/mcwforum
# JWT_SECRET=REPLACE_WITH_32PLUS_CHAR_RANDOM
# CORS_ORIGIN=https://www.example.com
# COOKIE_SECURE=true
# NODE_ENV=production
# TRUST_PROXY=1
# TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET
# ALLOW_DEMO_RESET=false
# ALLOW_DEMO_SEED=false
